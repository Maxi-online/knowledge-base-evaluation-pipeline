[App]
title = Knowledge Base Evaluation Pipeline
version = 1.0.0

[Logging]
level = INFO

[KnowledgeBase]
cache = var/articles.json
base_url =
knowledge_base_url =
article_selector = article
max_pages = 30
chunk_size = 1000
chunk_overlap = 100
prompt_system = knowledge_base_updating/prompts/system.txt
llm_name = openai
api_key =
model_name = gpt-4.1-mini
tpe_max_workers = 4
knowledge_base_storage = var/knowledge
keep_articles_separate = true

[GenQuestions]
prompt_system = knowledge_base_supporting/questions/prompts/system.txt
llm_name = openai
api_key =
model_name = gpt-4.1-mini
tpe_max_workers = 4
questions_storage = var/questions.json

[GenQuestionsSimilarity]
similarity_search_threshold = 0.7
simple_output = false
similarity_storage = var/similarity.json

[GenAnswers]
prompt_system = knowledge_base_supporting/answers/prompts/system.txt
llm_name = openai
api_key =
model_name = gpt-4.1-mini
tpe_max_workers = 4
answers_storage = var/answers.json
similarity_search_neighbours = 3

[GenScore]
prompt_system = knowledge_base_supporting/questions/score/prompts/system.txt
llm_name = openai
api_key =
model_name = gpt-4.1-mini
tpe_max_workers = 4
score_storage = var/scores.json
score_stats_storage = var/score-clusters.csv
clusters = 3
